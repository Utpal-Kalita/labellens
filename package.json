{
  "name": "labellens",
  "version": "0.1.0",
  "description": "Camera-based food packaging research platform powered by Presage SmartSpectra",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER=1 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "smoke": "node scripts/headless-smoke.mjs",
    "smoke:face": "node scripts/feed-face.mjs",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@smartspectra/node-sdk": "^3.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "recharts": "^2.15.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.65.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.labellens.app",
    "productName": "LabelLens",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@smartspectra/**",
      "node_modules/sql.js/dist/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "files": [
        "!node_modules/@smartspectra/node-sdk-darwin-arm64/**",
        "!node_modules/@smartspectra/node-sdk-win32-x64/**"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "LabelLens-Setup-${version}.${ext}",
      "signAndEditExecutable": false,
      "files": [
        "!node_modules/@smartspectra/node-sdk-darwin-arm64/**",
        "!node_modules/@smartspectra/node-sdk-linux-x64/**",
        "!node_modules/@smartspectra/node-sdk-linux-arm64/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}